generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model DocketRecord {
  id              String   @id @default(cuid())
  docketNumber    String?
  utility         String?
  partyName       String?
  projectRefNo    String?
  enquiryTenderNo String?
  titleBlockMode  String?  @default("standard")
  titleBlockCustomRows  Json?
  loiNo           String?
  Project         String?
  generationVersion Int? @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  attachments     Attachment[]
  mails           GtpMail[]

  @@index([utility])
  @@index([partyName])
  @@index([docketNumber])
}
model Attachment {
  id         String   @id @default(cuid())
  recordId   String
  name       String
  url        String
  type       String?
  size       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  record     DocketRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}
model User {
  id        String   @id
  email     String?
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// One row per step of the review flow: mailed for review, approved, mailed to the client.
// The latest row of a record is its current stage.
model GtpMail {
  id        String   @id @default(cuid())
  recordId  String
  stage     String   // "review" | "approved" | "client"
  version   Int
  sentTo    String?
  cc        String?
  byUser    String?
  messageId String?
  fileName  String?
  pdf       Bytes?   // the exact PDF mailed for review; the client gets this same file
  createdAt DateTime @default(now())

  record    DocketRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
}
