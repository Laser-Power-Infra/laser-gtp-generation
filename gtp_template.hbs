<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: Calibri, Arial, sans-serif; color: #000; }
  .page-border {
    position: fixed;
    inset: 0;
    border: 1.5px solid #FF0000;
    pointer-events: none;
    z-index: 1000;
  }
  .gtp-page { width: {{contentWidthPx}}px; margin: 0 auto; }
  table.gtp-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  table.gtp-table td { word-wrap: break-word; overflow-wrap: break-word; }
  tr { page-break-inside: avoid; }
  .page-break { page-break-before: always; }
</style>
</head>
<body>
  <div class="page-border"></div>
  {{#each tables}}
  {{#unless @first}}<div class="page-break"></div>{{/unless}}
  <div class="gtp-page">
    <table class="gtp-table">
      <thead>
      {{#each this.headerRows}}
        <tr{{#if this.height}} style="height:{{this.height}}pt;"{{/if}}>
        {{#each this.cells}}
          <td{{#if this.colspan}} colspan="{{this.colspan}}"{{/if}} style="{{this.style}}">{{this.text}}</td>
        {{/each}}
        </tr>
      {{/each}}
      </thead>
      <tbody>
      {{#each this.bodyRows}}
        <tr{{#if this.height}} style="height:{{this.height}}pt;"{{/if}}>
        {{#each this.cells}}
          <td{{#if this.colspan}} colspan="{{this.colspan}}"{{/if}}{{#if this.rowspan}} rowspan="{{this.rowspan}}"{{/if}} style="{{this.style}}">{{this.text}}</td>
        {{/each}}
        </tr>
      {{/each}}
      </tbody>
    </table>
  </div>
  {{/each}}
</body>
</html>
